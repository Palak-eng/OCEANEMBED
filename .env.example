# Django backend configuration
# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Supabase (required) ---
# Used to verify Supabase JWT bearer tokens from the frontend (api/supabase_auth.py)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Cache lifetime (seconds) for the Supabase JWKS signing keys (optional, default 600)
# SUPABASE_JWKS_CACHE_SECONDS=600

# --- Outgoing mail: OTP + calamity alerts (any SMTP provider works) ---
# Pick ONE provider block below. Gmail is the fastest free start.
#
# Option A — Gmail SMTP (free, ~500 mails/day, best for demo/SIH):
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Create an App Password (Google Account -> Security -> App passwords).
#   3. Use the 16-letter App Password below, NOT your login password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
# DEFAULT_FROM_EMAIL=your-gmail@gmail.com
#
# Option B — Brevo (free 300 mails/day, better inbox delivery, SMTP-compatible):
#   Sign up at brevo.com (no card) -> SMTP & API -> generate an SMTP key.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-brevo-login-email
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=alerts@yourdomain.com
#
# Option C — SendGrid (free 100 mails/day forever, good docs):
#   Sign up at sendgrid.com -> Settings -> API Keys -> create key, OR use
#   SMTP relay with username "apikey" and the API key as password.
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=alerts@yourdomain.com
#
# EMAIL_VERIFICATION_REQUIRED=true
